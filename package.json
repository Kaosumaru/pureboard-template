        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "prettier": "^3.9.8",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0"
