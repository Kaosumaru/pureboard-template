{
    "name": "pureboard-template",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production npx tsx src/server/index.ts",
        "build": "vite build",
        "dev": "tsx watch --exclude \"./vite.config.ts.*\" src/server/index.ts --host",
