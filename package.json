        "@mui/material": "^7.0.1",
        "@redux-devtools/extension": "^3.3.0",
        "express": "^5.1.0",
        "motion": "^12.6.3",
        "pureboard": "^2.1.0",
        "react": "19.0.0",
        "react-cookie": "^8.0.1",
        "react-device-detect": "^2.2.3",
        "react-dom": "19.0.0",
        "react-router-dom": "^7.1.1",
        "styled-components": "^6.5.3",
        "typed-signals": "^3.0.0",
        "vite-express": "^0.20.0",
        "vitest": "^5.0.1",
        "zustand": "^5.0.2"
